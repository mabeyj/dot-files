#!/bin/zsh

local -r stub_path="/tmp/sandbox-stub.txt"
local -r tmp_path="/tmp/sandbox"

usage() {
	cat <<-"EOF"
	sandbox [<option> ...] [-- <command> ...]

	Network options:

	  --allow-https "<method> <host>[/<path>]"
	    Allow HTTPS requests that match the given method, host, and path.
	    Method can be any HTTP method (GET, POST, etc.) or "*" to allow all
	    methods. Path can contain "*" wildcards or can be omitted to allow all
	    paths.

	    Examples:
	      --allow-https "GET example.com"
	      --allow-https "POST example.com/records/*/edit"
	      --allow-https "* example.com"

	  --allow-localhost <ports>
	    Allow serving on loopback on the given ports, specified as
	    a comma-separated list of numbers or ranges.

	    By default, Sandlock denies all TCP binds and connects. When HTTP and
	    DNS are fully restricted, the TCP restrictions are dropped entirely
	    (<ports> is ignored and can be arbitrary) because the sandbox has
	    a private network namespace. Otherwise, only the given ports can be
	    bound.

	    Examples:
	      --allow-localhost 9876
	      --allow-localhost 8000-8080,9876

	  --allow-network
	    Allow unrestricted network access.
	    WARNING: This is vulnerable to data exfiltration.

	    Intended for use with --no-sandlock, where no network restriction can be
	    enforced anyway. Prefer the restrictive options otherwise.

	  --allow-unsafe-dns
	    Allow DNS lookups for any host.
	    WARNING: This is vulnerable to data exfiltration.

	  --allow-unsafe-https
	    Allow GET requests and DNS lookups for any host.
	    WARNING: This is vulnerable to data exfiltration.

	File system options:

	  --allow-root
	    Allow commands to list the contents of the entire file system that they
	    have been granted access.

	  --allow-project
	    Allow read and write access to the current directory. If the current
	    directory is a Git worktree, then its main worktree will be allowed as
	    well.

	  --allow-project-read
	    Same as --allow-project, but read only.

	  --bind <path>
	    Allow read and write access to a file or directory at the specified
	    path.

	  --bind-read <path>
	    Same as --bind, but read only.

	Sandbox layer options:

	  --no-sandlock
	    Run under Bubblewrap only, without Sandlock.

	    The sandbox loses its ability to restrict the network and syscalls.
	    Bubblewrap still provides the mount namespace and file system
	    restrictions, including stub binds to conceal blocked paths.

	    This is needed by programs such as Chrome that crash due to certain
	    syscalls being blocked.

	    A sandbox nested inside a --no-sandlock sandbox can still enable
	    Sandlock and apply its own network restrictions.

	Environment variable options:

	  --env <name> <value>
	    Sets an environment variable within the sandbox.

	Options applying application presets:

	  --allow-npm
	    Allow access to the following for running npm:
	      ~/.npm                      (read and write)
	      ./node_modules              (read and write)
	      ./package-lock.json         (read and write)
	      ./package.json              (read and write)
	      https://registry.npmjs.org  (GET only)

	    Also allow read access to .npmrc files in the user's home directory, the
	    current directory, and all of its parents.

	Nesting sandboxes:

	  Sandboxes can be nested with some limitations.

	  The nested sandbox will inherit the file system of its parent sandbox. If
	  the nested sandbox uses Sandlock, it will be without any permission by
	  default, and you must rebind files and directories to give access. These
	  binds cannot be more permissive than those on its parent sandbox.

	  There can only be one Sandlock supervisor, owned by the outermost Sandlock
	  layer, which controls network and seccomp restrictions. If a supervisor
	  already exists, the nested sandbox is subject to the network restrictions
	  of the supervisor and cannot be restricted further. If there is no
	  supervisor yet, then the nested sandbox can set its own network
	  restrictions.

	  The nested sandbox will inherit all environment variables set on its
	  parent sandbox.
	EOF
}

run-sandbox() {
	local -r sandlock_ca_path=/tmp/sandlock-ca.pem

	local -ra ca_bundle_paths=(
		/etc/ca-certificates/extracted/tls-ca-bundle.pem
		/etc/ssl/cert.pem
		/etc/ssl/certs/ca-certificates.crt
	)
	local -r high_memory_limit=3G
	local -r max_memory_limit=4G

	# Nesting is detected from two markers the outer sandbox sets on the
	# environment.
	#
	# SANDBOX_NESTED means systemd-run and bwrap have already run and must be
	# skipped. SANDBOX_SANDLOCK means an outer Sandlock supervisor owns the
	# seccomp listener, so a nested Sandlock can only run in --no-supervisor
	# mode. Without that marker a nested sandbox may run a supervisor of its
	# own, and so may impose its own network restrictions.
	local -i nested=${+SANDBOX_NESTED}
	local -i outer_sandlock=${+SANDBOX_SANDLOCK}

	local -a bwrap_args=(
		--chdir "$PWD"
		--die-with-parent
		--unshare-all

		--clearenv
		--setenv SANDBOX_NESTED 1

		--dev /dev
		--proc /proc
		--tmpfs /tmp
		--bind "$tmp_path/tmp" /tmp

		# An initially empty home directory, so that programs can write
		# wherever they expect to without exposing the real home directory,
		# which may contain sensitive information (e.g., credentials in
		# ~/.config). Later binds mount real files over it as needed.
		# Contents persist across sandbox restarts but not across reboots.
		--bind "$tmp_path/home" "$HOME"

		# Sandlock mounts its own /etc/hosts, so this gets a bwrap bind only.
		# Passing --fs-read for the path makes Landlock fail to add the rule
		# once Sandlock has mounted over it.
		--ro-bind /etc/hosts /etc/hosts
	)

	local -a sandlock_supervisor_args=(
		--max-processes 512
	)
	local -a sandlock_env_args=()
	local -a sandlock_file_system_args=(
		--fs-write "$HOME"
		--fs-write /dev
		--fs-write /proc
		--fs-write /tmp
	)

	# Forward these environment variables into the sandbox when set.
	local env_name
	for env_name in \
		DO_NOT_TRACK \
		HOME \
		LANG \
		PATH \
		TERM \
		TERM_PROGRAM \
		TMUX \
		TMUX_PANE \
		USER \
		XDG_CACHE_HOME \
		XDG_CONFIG_HOME \
		XDG_DATA_DIRS
	do
		[[ -n "${(P)env_name}" ]] || continue
		bwrap_args+=(--setenv "$env_name" "${(P)env_name}")
	done

	# gai.conf and nsswitch.conf are needed in a network-free sandbox for
	# programs that serve on its own loopback.
	bind-read \
		"$HOME/.local/bin" \
		/bin \
		/etc/fonts \
		/etc/gai.conf \
		/etc/group \
		/etc/ld.so.cache \
		/etc/localtime \
		/etc/man_db.conf \
		/etc/nsswitch.conf \
		/etc/passwd \
		/lib \
		/lib64 \
		/usr

	local -i allow_network=0
	local -i allow_root=0
	local -i allow_project=0
	local -i allow_npm=0
	local -i allow_unsafe_dns=0
	local -i allow_unsafe_https=0
	local -i network_restricted=0
	local -i use_sandlock=1

	local allow_project_bind=bind-read

	local -a allow_localhost_ports=()
	local -a env_assignments=()

	while (( $# > 0 ))
	do
		case "$1" in
			--help)
				usage
				return 0
				;;

			--allow-https)
				check-enough-args 2 "$@" || return 1
				allow_network=1
				network_restricted=1
				sandlock_supervisor_args+=(--http-allow "$2")
				shift 2
				;;

			--allow-localhost)
				check-enough-args 2 "$@" || return 1
				allow_localhost_ports+=("$2")
				shift 2
				;;

			--allow-network)
				allow_network=1
				shift
				;;

			--allow-root)
				allow_root=1
				shift
				;;

			--allow-project)
				allow_project=1
				allow_project_bind=bind-write
				shift
				;;

			--allow-project-read)
				allow_project=1
				allow_project_bind=bind-read
				shift
				;;

			--allow-npm)
				allow_network=1
				allow_npm=1
				shift
				;;

			--allow-unsafe-dns)
				allow_network=1
				network_restricted=1
				allow_unsafe_dns=1
				shift
				;;

			--allow-unsafe-https)
				allow_network=1
				network_restricted=1
				allow_unsafe_dns=1
				allow_unsafe_https=1
				shift
				;;

			--bind)
				check-enough-args 2 "$@" || return 1
				bwrap_args+=(--bind "$2" "$2")
				sandlock_file_system_args+=(--fs-write "$2")
				shift 2
				;;

			--bind-read)
				check-enough-args 2 "$@" || return 1
				bwrap_args+=(--ro-bind "$2" "$2")
				sandlock_file_system_args+=(--fs-read "$2")
				shift 2
				;;

			--no-sandlock)
				use_sandlock=0
				shift
				;;

			--env)
				check-enough-args 3 "$@" || return 1
				env_assignments+=("$2=$3")
				shift 3
				;;

			--)
				shift
				break
				;;

			-*)
				echo "Unknown sandbox argument: $1" >&2
				usage >&2
				return 1
				;;

			*)
				break
				;;
		esac
	done

	if (( use_sandlock ))
	then
		# Tell nested sandboxes that a supervisor already owns the seccomp
		# listener. Set on both layers so the marker survives whichever one
		# actually runs.
		bwrap_args+=(--setenv SANDBOX_SANDLOCK 1)
		sandlock_env_args+=(--env SANDBOX_SANDLOCK=1)
	elif (( network_restricted ))
	then
		echo "[sandbox] WARNING: Network restrictions are not enforced without Sandlock" >&2
	fi

	if (( allow_network ))
	then
		bwrap_args+=(--share-net)
		sandlock_supervisor_args+=(
			--env NODE_EXTRA_CA_CERTS=$sandlock_ca_path
			--http-ca-out $sandlock_ca_path
			--http-port 443
		)

		# Sandlock's CA injection matches the literal path a client opens and
		# does not follow symlinks, so every trust bundle a client might read
		# needs its own injection.
		local ca_bundle_path
		for ca_bundle_path in "${ca_bundle_paths[@]}"
		do
			[[ -e "$ca_bundle_path" ]] || continue
			sandlock_supervisor_args+=(--http-inject-ca "$ca_bundle_path")
		done

		bind-read \
			/etc/ca-certificates \
			/etc/resolv.conf \
			/etc/ssl
	fi

	# Sandlock denies every TCP bind and connect by default, so a server on
	# loopback needs those relaxed. How depends on the network options.
	#
	# Without a network option, the sandbox has a private network namespace, so
	# the TCP protection is dropped: it can only ever reach its own loopback.
	# This is also the only mode in which Chrome runs, because --net-allow (and
	# every other network policy flag) switches on the supervisor's network
	# interception, which refuses loopback connects and fails
	# sendmsg(SCM_CREDENTIALS), crashing Chrome during Crashpad startup.
	#
	# With a network option, the host network namespace is shared, so access is
	# granted per port instead of dropping the protection.
	if (( ${#allow_localhost_ports} ))
	then
		if (( allow_network ))
		then
			local localhost_ports
			for localhost_ports in "${allow_localhost_ports[@]}"
			do
				sandlock_supervisor_args+=(
					--net-allow "127.0.0.1:$localhost_ports"
					--net-allow-bind "$localhost_ports"
				)
			done
		else
			sandlock_supervisor_args+=(--disable net-tcp)
		fi
	fi

	if (( allow_unsafe_dns ))
	then
		# Unsafe because it can be used to exfiltrate data via DNS requests.
		sandlock_supervisor_args+=(--net-allow "udp://127.0.0.53:53")

		# TODO: Instead of opening 127.0.0.53:53, run a whitelist-only DNS
		# responder inside the sandbox (dnsmasq --no-resolv with no upstreams,
		# or a small script) that answers from the /etc/hosts entries and
		# REFUSEs everything else, never forwarding upstream. Fixes
		# dns.resolve()-based lookups (Claude Code WebFetch) without creating
		# a DNS exfiltration channel.
	fi

	if (( allow_unsafe_https ))
	then
		sandlock_supervisor_args+=(--http-allow "GET *")
	fi

	if (( allow_root ))
	then
		sandlock_file_system_args+=(--fs-read /)
	fi

	if (( ! allow_project && ! allow_npm ))
	then
		# Need at least some access to the project directory to run a command.
		allow_project=1
	fi

	if (( allow_project ))
	then
		local -a project_dirs=(${(f)"$(get-project-dirs)"})

		local project_dir
		for project_dir in "${project_dirs[@]}"
		do
			"$allow_project_bind" "$project_dir"
		done

		# Blocked paths are concealed by binding a stub file over them.
		# Sandlock's --fs-deny is not used because denied file access makes some
		# programs hang or crash (e.g., Claude Code). A nested sandbox relies on
		# the outer sandbox's stub binds, which only cover blocked paths found
		# in the outer sandbox's project directories.
		if (( ! nested ))
		then
			local blocked_path
			for blocked_path in ${(f)"$(get-blocked-paths "${project_dirs[@]}")"}
			do
				bwrap_args+=(--ro-bind "$stub_path" "$blocked_path")
			done
		fi
	fi

	if (( allow_npm ))
	then
		sandlock_supervisor_args+=(
			--http-allow "GET registry.npmjs.org"
		)

		local -aU npmrc_paths=(${(f)"$(get-npmrc-paths)"})
		bind-read "${npmrc_paths[@]}"
		bind-write \
			"$HOME/.npm" \
			"$PWD/node_modules" \
			"$PWD/package-lock.json" \
			"$PWD/package.json"
	fi

	# --env is applied through whichever layer actually runs: bwrap when this is
	# the outermost sandbox, Sandlock when nested under one, and a plain env
	# prefix when neither layer is left to carry it.
	local -a env_prefix=()
	local env_assignment
	if (( ! nested ))
	then
		for env_assignment in "${env_assignments[@]}"
		do
			bwrap_args+=(
				--setenv "${env_assignment%%=*}" "${env_assignment#*=}"
			)
		done
	elif (( use_sandlock ))
	then
		for env_assignment in "${env_assignments[@]}"
		do
			sandlock_env_args+=(--env "$env_assignment")
		done
	elif (( ${#env_assignments} ))
	then
		env_prefix=(env "${env_assignments[@]}")
	fi

	local -a cmd=()
	if (( ! nested ))
	then
		cmd+=(
			systemd-run
				--collect
				--property "MemoryHigh=$high_memory_limit"
				--property "MemoryMax=$max_memory_limit"
				--quiet
				--scope
				--user
				--
			bwrap
				"${bwrap_args[@]}"
				--
		)
		set-up-sandbox
	elif (( outer_sandlock ))
	then
		# An outer supervisor already owns the seccomp listener. Starting
		# another one would fail.
		sandlock_supervisor_args=(--no-supervisor)
	fi

	if (( use_sandlock ))
	then
		cmd+=(
			sandlock
				run
				"${sandlock_supervisor_args[@]}"
				"${sandlock_env_args[@]}"
				"${sandlock_file_system_args[@]}"
				--
		)
	fi

	cmd+=("${env_prefix[@]}")

	if (( $# == 0 ))
	then
		cmd+=(/bin/bash)
	else
		cmd+=("$@")
	fi

	"${cmd[@]}"
}

# Checks that enough arguments remain for an option.
#
# $1 is the number of arguments it needs, including the option itself, followed
# by the remaining arguments that are left to parse.
check-enough-args() {
	local -ri needed="$1"
	shift

	(( $# >= needed )) && return 0

	echo "Missing argument for option: $1" >&2
	return 1
}

# Sandlock has no --fs-read-try/--fs-write-try, so paths that do not exist are
# skipped. Appends to run-sandbox's bwrap_args and sandlock_file_system_args.
bind-read() {
	bind-existing --ro-bind --fs-read "$@"
}

bind-write() {
	bind-existing --bind --fs-write "$@"
}

bind-existing() {
	local -r bwrap_arg="$1"
	local -r sandlock_arg="$2"
	shift 2

	local bind_path
	for bind_path in "$@"
	do
		[[ -e "$bind_path" ]] || continue

		bwrap_args+=($bwrap_arg "$bind_path" "$bind_path")
		sandlock_file_system_args+=($sandlock_arg "$bind_path")
	done
}

get-project-dirs() {
	echo "$PWD"

	if [[ -f ".git" ]]
	then
		local git_dir="$(sed -n "s/^gitdir: //p" ".git")"
		realpath "$git_dir/../../.."
	fi
}

# Lists every path where npm may look for a .npmrc file.
#
# This includes the user's home directory, the current directory, and all of its
# parents. The listed paths may not exist.
get-npmrc-paths() {
	echo "$HOME/.npmrc"

	local dir="$PWD"
	while :
	do
		echo "${dir%/}/.npmrc"
		[[ "$dir" == "/" ]] && break
		dir="${dir:h}"
	done
}

get-blocked-paths() {
	local project_dir
	for project_dir in "$@"
	do
		find \
			"$project_dir" \
			-maxdepth 1 \
			-regex ".*/[^/]*\(password\|production[^/]*\.\(ini\|json\)\)"
	done
}

set-up-sandbox() {
	mkdir --parents "$tmp_path/home" "$tmp_path/tmp"

	# The virtual home collects private data (shell history, browser
	# profiles), so keep it out of reach of other local users.
	chmod 700 "$tmp_path"

	echo "(Access blocked by sandbox: file may contain sensitive information)" \
		> "$stub_path"
}

run-sandbox "$@"
